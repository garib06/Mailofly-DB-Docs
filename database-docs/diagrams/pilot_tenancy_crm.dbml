// Mailofly Pilot ERD: Tenancy & CRM Domains

Table public.accounts {
  id uuid
  user_id uuid
  provider_type USER-DEFINED
  name text
  smtp_host text
  smtp_port smallint
  smtp_username text
  smtp_password text
  google_access_token text
  google_refresh_token text
  google_email text
  created_at timestamp with time zone
  updated_at timestamp with time zone
  daily_mail_limit integer
  daily_mail_used integer
  daily_mail_used_date date
  google_expires_at timestamp with time zone
  google_scope text
  google_token_type text
  account_key text
  provisioned_by USER-DEFINED
  custom_from_email text
  custom_from_display_name text
  billing_locked boolean
  organization_id uuid
  is_active boolean
}

Table public.contact_properties {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name text [not null]
  type text [not null]
  fallback_value text
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
  key text [not null]
}

Table public.contact_property_values {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  contact_id uuid [not null]
  property_id uuid [not null]
  value text
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
}

Table public.contact_segments {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  name text [not null]
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
  organization_id uuid [not null]
  managed_topic_id uuid
}

Table public.contact_subscription_challenges {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  subscription_id uuid [not null]
  token_hash text [not null]
  token_ciphertext text
  expires_at timestamp with time zone [not null]
  consumed_at timestamp with time zone
  created_at timestamp with time zone [not null, default: `now()`]
  notification_status text [not null, default: `\'pending\'::text`]
  email_id uuid
  attempts integer [not null, default: `0`]
  updated_at timestamp with time zone [not null, default: `now()`]
  error text
}

Table public.contact_subscription_events {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  contact_id uuid [not null]
  topic_id uuid [not null]
  event text [not null]
  source text [not null]
  created_at timestamp with time zone [not null, default: `now()`]
}

Table public.contact_topics {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  contact_id uuid [not null]
  topic_id uuid [not null]
  status text [not null, default: `\'subscribed\'::text`]
  updated_at timestamp with time zone [not null, default: `now()`]
  subscription text [not null, default: `\'opt_in\'::text`]
  consent_state text
  consent_version text
  consent_source text
  requested_at timestamp with time zone
  confirmed_at timestamp with time zone
  unsubscribed_at timestamp with time zone
  request_window timestamp with time zone
  request_count integer [not null, default: `0`]
  legacy_subscriber_id uuid
}

Table public.contacts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  email text [not null]
  name text
  created_at timestamp with time zone [not null, default: `now()`]
  status text [not null, default: `\'subscribed\'::text`]
  organization_id uuid [not null]
  email_validation_status text
  email_validation_score smallint
  email_validation_checked_at timestamp with time zone
  email_validation_details jsonb
  properties jsonb [not null, default: `\'{}\'::jsonb`]
  unsubscribed boolean [not null, default: `false`]
}

Table public.global_suppression_list {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email text [not null]
  reason text [not null]
  source text [not null, default: `\'ses_webhook\'::text`]
  metadata jsonb [not null, default: `\'{}\'::jsonb`]
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
}

Table public.identities {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid
  provider_type USER-DEFINED [not null]
  name text [not null]
  smtp_host text
  smtp_port smallint
  smtp_username text
  smtp_password text
  google_access_token text
  google_refresh_token text
  google_email text
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
  daily_mail_limit integer [not null, default: `500`]
  daily_mail_used integer [not null, default: `0`]
  daily_mail_used_date date
  google_expires_at timestamp with time zone
  google_scope text
  google_token_type text
  account_key text [not null, default: `(\'acc_\'::text || replace((gen_random_uuid())::text, \'-\'::text, \'\'::text))`]
  provisioned_by USER-DEFINED [not null, default: `\'user\'::account_provisioned_by`]
  custom_from_email text
  custom_from_display_name text
  billing_locked boolean [not null, default: `false`]
  organization_id uuid [not null]
  is_active boolean [not null, default: `true`]
  identity_email text
}

Table public.managed_audience_programs {
  name text [pk, not null]
  organization_id uuid [not null]
  user_id uuid [not null]
  topic_id uuid [not null]
  segment_id uuid [not null]
  legacy_bridge_enabled boolean [not null, default: `true`]
}

Table public.newsletter_signup_windows {
  ip_hash text [pk, not null]
  window_start timestamp with time zone [not null, default: `now()`]
  attempts integer [not null, default: `1`]
}

Table public.newsletter_subscribers {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email text [not null]
  created_at timestamp with time zone [not null, default: `now()`]
  status text [not null, default: `\'pending\'::text`]
  confirmation_hash text
  confirmation_expires_at timestamp with time zone
  confirmation_requested_at timestamp with time zone
  confirmed_at timestamp with time zone
  unsubscribed_at timestamp with time zone
  consent_version text
  request_window timestamp with time zone
  request_count integer [not null, default: `0`]
}

Table public.organization_invitations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  email text [not null]
  role USER-DEFINED [not null, default: `\'viewer\'::organization_role`]
  token text [not null, default: `encode(extensions.gen_random_bytes(32), \'hex\'::text)`]
  invited_by uuid [not null]
  expires_at timestamp with time zone [not null, default: `(now() + \'7 days\'::interval)`]
  accepted_at timestamp with time zone
  created_at timestamp with time zone [not null, default: `now()`]
}

Table public.organization_members {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  user_id uuid [not null]
  role USER-DEFINED [not null, default: `\'viewer\'::organization_role`]
  joined_at timestamp with time zone [not null, default: `now()`]
}

Table public.organizations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name text [not null]
  slug text [not null]
  created_by uuid
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
  type USER-DEFINED [not null, default: `\'business\'::organization_type`]
  credit_balance_cents integer [not null, default: `0`]
  ses_configuration_set text
  unsubscribe_page_config jsonb [not null, default: `\'{}\'::jsonb`]
  is_locked boolean [not null, default: `false`]
  locked_at timestamp with time zone
  locked_reason text
  auto_verify_contacts boolean [not null, default: `false`]
}

Table public.properties {
  id uuid
  organization_id uuid
  name text
  type text
  fallback_value text
  created_at timestamp with time zone
  updated_at timestamp with time zone
}

Table public.roles {
  name USER-DEFINED [pk, not null]
}

Table public.segment_contacts {
  segment_id uuid [pk, not null]
  contact_id uuid [pk, not null]
  created_at timestamp with time zone [not null, default: `now()`]
}

Table public.segment_google_sheets {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  segment_id uuid [not null]
  spreadsheet_id text [not null]
  sheet_name text [not null]
  header_row integer [not null, default: `1`]
  last_processed_row integer [not null, default: `1`]
  channel_id text
  resource_id text
  channel_expiration timestamp with time zone
  last_synced_at timestamp with time zone
  last_sync_error text
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
  organization_id uuid [not null]
}

Table public.tenant_suppression_list {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  email text [not null]
  reason text [not null]
  source text [not null, default: `\'ses_webhook\'::text`]
  metadata jsonb [not null, default: `\'{}\'::jsonb`]
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
}

Table public.topics {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name text [not null]
  slug text [not null]
  description text
  default_subscription text [not null, default: `\'opt_in\'::text`]
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
  visibility text [not null, default: `\'private\'::text`]
  requires_confirmation boolean [not null, default: `false`]
}

Table public.user_onboarding_responses {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  question_key text [not null]
  answer_value text [not null]
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
}

Table public.users {
  id uuid [pk, not null]
  role USER-DEFINED [not null, default: `\'user\'::user_role`]
  created_at timestamp with time zone [not null, default: `now()`]
  updated_at timestamp with time zone [not null, default: `now()`]
  email text
  display_name text
  company_name text
  onboarding_completed boolean [not null, default: `false`]
  has_email_password boolean [not null, default: `false`]
  user_type USER-DEFINED [not null, default: `\'free\'::user_billing_type`]
  account_type USER-DEFINED [not null, default: `\'transactional_email_users\'::user_account_type`]
  onboarding_first_email_sent_at timestamp with time zone
  default_organization_id uuid
  mobile_phone text
  mobile_country_code text
  marketing_contact_consent boolean [not null, default: `false`]
  marketing_contact_consent_at timestamp with time zone
  phone text
  phone_country_code text
  referredby uuid
  referral_code text
  admin_role_id uuid
}

Table auth.users {
  id uuid [pk, not null]
  email text
  created_at timestamp
}

// Relationship Constraints
Ref identities_user_id_fkey: auth.identities.user_id > auth.users.id [delete: cascade]
Ref contact_properties_organization_id_fkey: public.contact_properties.organization_id > public.organizations.id [delete: cascade]
Ref contact_property_values_contact_id_fkey: public.contact_property_values.contact_id > public.contacts.id [delete: cascade]
Ref contact_property_values_organization_id_fkey: public.contact_property_values.organization_id > public.organizations.id [delete: cascade]
Ref contact_property_values_property_id_fkey: public.contact_property_values.property_id > public.contact_properties.id [delete: cascade]
Ref contact_segments_managed_topic_id_fkey: public.contact_segments.managed_topic_id > public.topics.id [delete: restrict]
Ref contact_segments_organization_id_fkey: public.contact_segments.organization_id > public.organizations.id [delete: cascade]
Ref recipient_folders_user_id_fkey: public.contact_segments.user_id > auth.users.id [delete: cascade]
Ref contact_subscription_challenges_subscription_id_fkey: public.contact_subscription_challenges.subscription_id > public.contact_topics.id [delete: cascade]
Ref contact_subscription_events_contact_id_fkey: public.contact_subscription_events.contact_id > public.contacts.id [delete: cascade]
Ref contact_subscription_events_organization_id_fkey: public.contact_subscription_events.organization_id > public.organizations.id [delete: cascade]
Ref contact_subscription_events_topic_id_fkey: public.contact_subscription_events.topic_id > public.topics.id [delete: cascade]
Ref contact_topics_contact_id_fkey: public.contact_topics.contact_id > public.contacts.id [delete: cascade]
Ref contact_topics_organization_id_fkey: public.contact_topics.organization_id > public.organizations.id [delete: cascade]
Ref contact_topics_topic_id_fkey: public.contact_topics.topic_id > public.topics.id [delete: cascade]
Ref contacts_organization_id_fkey: public.contacts.organization_id > public.organizations.id [delete: cascade]
Ref recipients_user_id_fkey: public.contacts.user_id > auth.users.id [delete: cascade]
Ref identities_organization_id_fkey: public.identities.organization_id > public.organizations.id [delete: cascade]
Ref identities_user_id_fkey: public.identities.user_id > auth.users.id [delete: cascade]
Ref managed_audience_programs_organization_id_fkey: public.managed_audience_programs.organization_id > public.organizations.id [delete: restrict]
Ref managed_audience_programs_segment_id_fkey: public.managed_audience_programs.segment_id > public.contact_segments.id [delete: restrict]
Ref managed_audience_programs_topic_id_fkey: public.managed_audience_programs.topic_id > public.topics.id [delete: restrict]
Ref managed_audience_programs_user_id_fkey: public.managed_audience_programs.user_id > auth.users.id [delete: restrict]
Ref organization_invitations_invited_by_fkey: public.organization_invitations.invited_by > auth.users.id [delete: cascade]
Ref organization_invitations_organization_id_fkey: public.organization_invitations.organization_id > public.organizations.id [delete: cascade]
Ref organization_members_organization_id_fkey: public.organization_members.organization_id > public.organizations.id [delete: cascade]
Ref organization_members_user_id_fkey: public.organization_members.user_id > auth.users.id [delete: cascade]
Ref organizations_created_by_fkey: public.organizations.created_by > auth.users.id [delete: set null]
Ref folder_recipients_folder_id_fkey: public.segment_contacts.segment_id > public.contact_segments.id [delete: cascade]
Ref folder_recipients_recipient_id_fkey: public.segment_contacts.contact_id > public.contacts.id [delete: cascade]
Ref segment_google_sheets_organization_id_fkey: public.segment_google_sheets.organization_id > public.organizations.id [delete: cascade]
Ref segment_google_sheets_segment_id_fkey: public.segment_google_sheets.segment_id > public.contact_segments.id [delete: cascade]
Ref segment_google_sheets_user_id_fkey: public.segment_google_sheets.user_id > auth.users.id [delete: cascade]
Ref tenant_suppression_list_organization_id_fkey: public.tenant_suppression_list.organization_id > public.organizations.id [delete: cascade]
Ref topics_organization_id_fkey: public.topics.organization_id > public.organizations.id [delete: cascade]
Ref user_onboarding_responses_user_id_fkey: public.user_onboarding_responses.user_id > public.users.id [delete: cascade]
Ref users_default_organization_id_fkey: public.users.default_organization_id > public.organizations.id [delete: set null]
Ref users_id_fkey: public.users.id > auth.users.id [delete: cascade]
Ref users_referredby_fkey: public.users.referredby > public.users.id [delete: set null]
Ref users_role_fkey: public.users.role > public.roles.name [delete: restrict]